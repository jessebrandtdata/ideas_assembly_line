__pycache__/
*.tmp
_site/

# Bulk data stays out of git: collect_warehouse.py and delays.py rebuild it in seconds, and the
# Pages workflow rebuilds it on every run. Tracked under data/: congresses.json (the index) and, per
# Congress, stats.json and warehouse.json (a small dated snapshot) plus pages.csv and ingest.csv
# (GovInfo lookups, one API call per text version, the one input that is slow to rebuild).
/data/congresses.js
/data/*/versions.csv
/data/*/summaries.csv
/data/*/delays.csv
/data/*/awaiting.csv
/data/*/delays.json
/data/*/delays.js
